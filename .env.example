# Public site origin used for canonical URLs, hreflang, sitemap, and robots.
# Override in production (e.g. https://meridian-demo.example.com).
# Include the sub-path when served from one, e.g.
# https://yahome.github.io/nextjs-multilingual-demo
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional sub-path the static export is served from (GitHub Pages project
# site). Leave empty for local dev / root-domain hosting.
# NEXT_PUBLIC_BASE_PATH=/nextjs-multilingual-demo
